# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Telegram bot (server-side only). Create the token with BotFather and choose
# your own random webhook secret; do not prefix either value with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Register both messages and button callbacks after configuring the public URL:
# pnpm telegram:webhook

# Product authentication. Generate a separate random value of at least 32 bytes.
# The name matters: the application reads VARDAGSRO_AUTH_SECRET or
# BETTER_AUTH_SECRET, and nothing else. A value set as AUTH_SECRET is ignored,
# which in production means the app refuses to start rather than running with a
# weak key.
VARDAGSRO_AUTH_SECRET=
VARDAGSRO_BASE_URL=http://localhost:3000

# Only used by `pnpm account:bootstrap`, never by the running application. Set it
# for the single command that creates or resets a login, then unset it again.
VARDAGSRO_BOOTSTRAP_PASSWORD=

# Mail. Carries account plumbing only: a password reset link and an invitation.
# No schedules, documents or names of children are ever sent by mail, so no mail
# provider becomes a processor of the family's own content.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Only used by the remote release tests. A real product login on the target
# environment, so the run exercises the same session path as the family does.
VARDAGSRO_TEST_EMAIL=
VARDAGSRO_TEST_PASSWORD=

# Backward-compatible local fallback, used only when both primary values above are empty.
ZICKARIS_ADMIN_EMAIL=
ZICKARIS_ADMIN_PASSWORD=

# R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Local PostgreSQL from compose.yaml
FAMILY_DATABASE_URL=postgresql://familjen:familjen-dev@127.0.0.1:5434/familjen
